---
// Navbar - Styled as a ripped notebook paper strip pinned with a red thumbtack
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white ripped-paper-bottom shadow-md border-none">
  <!-- Pinned torn notebook paper strip inside container -->
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-3 pb-5 flex items-center justify-between">
    <!-- Logo/Brand -->
    <a href="/" class="flex items-center gap-2 group relative">
      <span class="text-2xl font-bold tracking-tight text-[var(--color-text)] font-handwritten hover:text-[var(--color-accent-dark)] transition-colors rotate-[-1deg]">pip-it-up</span>
      <span class="text-[9px] px-1.5 py-0.5 rounded border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text-muted)] font-bold font-mono">v0.1.10</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="/docs" class="text-base font-handwritten text-[var(--color-text)] hover:text-[var(--color-accent-dark)] hover:underline decoration-wavy transition-colors">
        documentation
      </a>
      <a href="https://pip-it-up-playground.vercel.app" target="_blank" rel="noopener" class="text-base font-handwritten text-[var(--color-text)] hover:text-[var(--color-accent-dark)] hover:underline decoration-wavy transition-colors">
        Playground
      </a>
      <a href="https://github.com/Shakya47/pip-it-up" target="_blank" rel="noopener" class="text-base font-handwritten text-[var(--color-text)] hover:text-[var(--color-accent-dark)] hover:underline decoration-wavy transition-colors">
        GitHub
      </a>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <a 
        href="https://github.com/Shakya47/pip-it-up" 
        target="_blank" 
        rel="noopener"
        class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
        aria-label="GitHub Repository"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a 
        href="/docs" 
        class="inline-flex items-center justify-center px-4 py-1 font-handwritten text-lg font-bold bg-[var(--color-accent)] hover:bg-[var(--color-accent-light)] border-2 border-[var(--color-border)] text-[var(--color-text)] shadow-sm hover:rotate-2 rotate-[-1deg] transition-all hover:scale-105 active:scale-95 duration-100"
      >
        Get Started
      </a>
    </div>
  </div>
</header>
