---
// Feature Grid - Styled as a loose collage of pastel sticky notes/post-its
interface Feature {
  icon: string;
  title: string;
  description: string;
  /** Tailwind classes selecting one of the --note-* token sets. */
  colorClasses: string;
  rotation: string;
  /** Stamps a "new" badge on the note. Only the 0.2.0 additions set it. */
  isNew?: boolean;
}

const features: Feature[] = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>`,
    title: 'Route-Persistent PiP',
    description: 'Wrap the app in `PipProvider`, drop a `PipAnchor` per route. The PiP window survives navigation — no unmount, no reload.',
    colorClasses: 'bg-[var(--note-green-bg)] border-[var(--note-green-line)] text-[var(--note-green-ink)] hover:bg-[var(--note-green-hover)]',
    rotation: 'rotate-[-2deg]',
    isNew: true,
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z"/></svg>`,
    title: 'Zero Remounts',
    description: 'Video playheads, canvas bitmaps, WebGL contexts and WebRTC streams keep running. The DOM node is moved, never recreated.',
    colorClasses: 'bg-[var(--note-pink-bg)] border-[var(--note-pink-line)] text-[var(--note-pink-ink)] hover:bg-[var(--note-pink-hover)]',
    rotation: 'rotate-[1.5deg]',
    isNew: true,
