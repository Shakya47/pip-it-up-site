  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>`,
    title: 'TypeScript-First',
    description: 'Generic-typed hooks, full IntelliSense, zero type casting needed.',
    colorClasses: 'bg-[var(--note-blue-bg)] border-[var(--note-blue-line)] text-[var(--note-blue-ink)] hover:bg-[var(--note-blue-hover)]',
    rotation: 'rotate-[-1.5deg]',
  },
];
---

<section id="features" class="relative py-24 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16" data-reveal>
      <h2 class="text-4xl sm:text-5xl font-handwritten font-extrabold mb-4 text-[var(--color-text)]">
        Everything you need for PiP
      </h2>
      <p class="text-base sm:text-lg font-typewriter text-[var(--color-text-muted)] max-w-2xl mx-auto">
        A comprehensive API designed for real-world use cases — from simple pop-outs to route-persistent editor workflows.
      </p>
    </div>

    <!-- Feature grid (loose sticky notes) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-stagger>
      {features.map((feature) => (
        <div class:list={['sticky-note relative p-6 border-2 border-dashed shadow-md transition-all duration-300 flex flex-col items-start', feature.rotation, feature.colorClasses]}>
          {feature.isNew && (
            <span class="absolute -top-2 -right-2 rotate-[8deg] px-1.5 py-0.5 text-[10px] font-bold font-handwritten tracking-wider uppercase border-2 border-[var(--color-border)] bg-[var(--color-accent)] text-[var(--color-on-accent)] shadow-[1px_1px_0px_var(--color-border)]">
              new
            </span>
          )}
          <!-- Ink Icon -->
          <div class="mb-4 opacity-80">
            <Fragment set:html={feature.icon} />
          </div>
          <!-- Title -->
          <h3 class="text-2xl font-bold font-handwritten mb-2 tracking-wide">{feature.title}</h3>
          <!-- Description -->
          <p class="text-sm font-sans leading-relaxed opacity-95">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
