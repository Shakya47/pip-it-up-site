    rotation: 'rotate-[-2deg]',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/></svg>`,
    title: 'Auto-sizing & Responsive',
    description: 'Windows adapt to content size automatically. Use `isInsidePip` for responsive PiP layouts.',
    colorClasses: 'bg-[var(--note-green-bg)] border-[var(--note-green-line)] text-[var(--note-green-ink)] hover:bg-[var(--note-green-hover)]',
    rotation: 'rotate-[2.5deg]',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>`,
    title: 'Keyboard Forwarding',
    description: 'Cmd+S, Cmd+K, and all shortcuts keep working inside the PiP window.',
    colorClasses: 'bg-[var(--note-purple-bg)] border-[var(--note-purple-line)] text-[var(--note-purple-ink)] hover:bg-[var(--note-purple-hover)]',
    rotation: 'rotate-[-1deg]',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>`,
