---
// Browser Support - Styled as a typewriter sheet taped down with blue Washi tape
const browsers = [
  { name: 'Chrome', version: '116+', supported: true, icon: 'chrome' },
  { name: 'Edge', version: '116+', supported: true, icon: 'edge' },
  { name: 'Firefox', version: 'N/A', supported: false, note: 'Fallback', icon: 'firefox' },
  { name: 'Safari', version: 'N/A', supported: false, note: 'Fallback', icon: 'safari' },
];
---

<section id="browser-support" class="relative py-24 px-4 sm:px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-16" data-reveal>
      <h2 class="text-4xl sm:text-5xl font-handwritten font-extrabold mb-4 text-[var(--color-text)]">
        Browser Support
      </h2>
      <p class="text-base sm:text-lg font-typewriter text-[var(--color-text-muted)] max-w-xl mx-auto">
        Built on the <a href="https://developer.chrome.com/docs/web-platform/document-picture-in-picture/" target="_blank" rel="noopener" class="text-[var(--color-text)] underline decoration-wavy hover:text-[var(--color-accent-dark)]">Document PiP API</a> with graceful fallbacks.
      </p>
    </div>

    <!-- Taped typewriter sheet container -->
    <div class="bg-[var(--paper-white)] border-2 border-[var(--color-border)] shadow-md p-6 sm:p-8 max-w-2xl mx-auto relative rotate-[-1deg] font-typewriter" data-reveal>
      <!-- Blue Washi Tapes on corners -->
      <div class="absolute -top-4 -left-6 washi-tape washi-tape-blue rotate-[-15deg] z-10">COMPATIBILITY</div>
      <div class="absolute -bottom-4 -right-4 washi-tape washi-tape-blue rotate-[12deg] z-10">SECURE</div>

      <table class="w-full text-left">
        <thead>
          <tr class="border-b-2 border-[var(--color-border)]">
            <th class="pb-3 text-sm font-bold text-[var(--color-text)] uppercase tracking-wider">Browser</th>
            <th class="pb-3 text-sm font-bold text-[var(--color-text)] uppercase tracking-wider">Version</th>
            <th class="pb-3 text-sm font-bold text-[var(--color-text)] uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody>
          {browsers.map((browser, i) => (
            <tr class:list={['transition-colors hover:bg-[var(--color-bg-elevated)]', i < browsers.length - 1 && 'border-b border-[var(--color-border-subtle)]']}>
              <td class="py-4">
                <span class="text-base font-bold text-[var(--color-text)]">{browser.name}</span>
              </td>
              <td class="py-4 text-[var(--color-text-muted)] text-sm">{browser.version}</td>
              <td class="py-4">
                {browser.supported ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded border border-emerald-600 bg-[var(--note-green-bg)] text-[var(--note-green-ink)] text-xs font-bold font-sans">
                    ✓ Full Support
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded border border-[var(--note-yellow-line)] bg-[var(--note-yellow-bg)] text-[var(--note-yellow-ink)] text-xs font-bold font-sans">
                    ⚠ {browser.note}
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- Note inside typewriter sheet -->
      <div class="mt-6 pt-4 border-t border-[var(--color-border)]">
        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
          * Requires HTTPS and a user gesture (click/keypress) to open. Firefox & Safari fall back or trigger your custom layout handler gracefully.
        </p>
      </div>
    </div>
  </div>
</section>
