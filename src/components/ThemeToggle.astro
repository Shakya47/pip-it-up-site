---
// Theme toggle — styled as a little rubber stamp that flips the zine between
// "ink on paper" and "chalk on card". Renders both glyphs and lets CSS pick,
// so there is no hydration flash and no JS needed before first paint.
---

<button
  id="theme-toggle"
  type="button"
  class="relative inline-flex items-center justify-center w-8 h-8 border-2 border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] rotate-[-3deg] hover:rotate-2 hover:scale-110 active:scale-95 transition-all duration-150 shadow-[2px_2px_0px_var(--color-border)]"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <!-- Sun: shown while the page is light -->
  <svg class="theme-icon-light w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <!-- Moon: shown while the page is dark -->
  <svg class="theme-icon-dark w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
  </svg>
</button>

<style is:global>
  /* Only ever one glyph visible. Driven by the same class/media pair as the
     palette, so the icon can never disagree with the surface it sits on. */
  .theme-icon-dark { display: none; }
  .theme-icon-light { display: block; }

  html.dark .theme-icon-dark { display: block; }
  html.dark .theme-icon-light { display: none; }

  @media (prefers-color-scheme: dark) {
    html:not(.light):not(.dark) .theme-icon-dark { display: block; }
    html:not(.light):not(.dark) .theme-icon-light { display: none; }
  }
</style>

<script>
  const KEY = 'pip-it-up-theme';
  const root = document.documentElement;

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    // Resolve what is actually on screen right now, which may be the OS
    // preference rather than an explicit class, then flip away from it.
    const isDark = root.classList.contains('dark')
      || (!root.classList.contains('light')
        && window.matchMedia('(prefers-color-scheme: dark)').matches);

    root.classList.toggle('dark', !isDark);
    root.classList.toggle('light', isDark);
    try { localStorage.setItem(KEY, isDark ? 'light' : 'dark'); } catch { /* private mode */ }
  });
</script>
